generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MASTER
  OWNER
  MANAGER
  EMPLOYEE
}

enum Plan {
  ESSENCIAL
  PROFISSIONAL
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELED
  BLOCKED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_SERVICE
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum TicketStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_FORGE
  RESOLVED
}


enum FiscalEnvironment {
  HOMOLOGATION
  PRODUCTION
}

enum FiscalIntegrationType {
  NATIONAL
  MUNICIPAL
}

enum FiscalDocumentStatus {
  DRAFT
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELED
}

enum ModuleCode {
  FISCAL
  WHATSAPP
  LOYALTY
  ONLINE_BOOKING
  AI
  TUTOR_APP
}

model CompanyModule {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    ModuleCode
  enabled   Boolean    @default(false)
  price     Decimal?   @db.Decimal(10, 2)
  activatedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@unique([companyId, module])
  @@index([companyId, enabled])
}

model ContractAcceptance {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contractVersion String
  contractHash    String
  ipAddress       String?
  userAgent       String?
  acceptedAt      DateTime @default(now())
  metadata        Json?
  @@index([companyId, acceptedAt])
  @@index([contractVersion])
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  tradeName          String?
  document           String?            @unique
  email              String?
  phone              String?
  logoUrl             String?
  plan                Plan               @default(ESSENCIAL)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  asaasCustomerId      String?            @unique
  asaasSubscriptionId  String?            @unique
  billingType          String?
  nextBillingDate      DateTime?
  downgradeLockedUntil DateTime?
  pendingPlan          Plan?
  pendingPlanRequestedAt DateTime?
  trialEndsAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  onboardingCompleted Boolean            @default(false)
  users               User[]
  tutors              Tutor[]
  pets                Pet[]
  services            Service[]
  appointments        Appointment[]
  appointmentItems     AppointmentServiceItem[]
  receivables         Receivable[]
  payments            Payment[]
  products            Product[]
  stockMovements      StockMovement[]
  loyaltyAccounts     LoyaltyAccount[]
  planHistory         PlanHistory[]
  tickets             ConnectTicket[]
  auditLogs           AuditLog[]
  asaasWebhookEvents  AsaasWebhookEvent[]
  modules             CompanyModule[]
  contractAcceptances ContractAcceptance[]
  fiscalConfig        FiscalConfig?
  fiscalDocuments     FiscalDocument[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     ConnectMessage[]
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]
  contractAcceptances ContractAcceptance[]
  @@index([companyId])
}

model Tutor {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  document  String?
  notes     String?
  address   String?
  number    String?
  complement String?
  neighborhood String?
  city      String?
  state     String?
  zipCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
  appointments Appointment[]
  receivables Receivable[]
  loyaltyAccount LoyaltyAccount?
  @@index([companyId, name])
}

model Pet {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name        String
  species     String
  breed       String?
  sex         String?
  size        String?
  color       String?
  birthDate   DateTime?
  neutered    Boolean  @default(false)
  temperament String?
  careNotes   String?
  weight      Decimal? @db.Decimal(8, 3)
  photoUrl    String?
  carePreferences Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  appointments Appointment[]
  @@index([companyId, name])
  @@index([tutorId])
}

model Service {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  durationMinutes Int      @default(60)
  price           Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  generatesPoints Boolean  @default(false)
  generatesCashback Boolean @default(false)
  fiscalServiceCode String?
  fiscalCnae        String?
  fiscalNbsCode     String?
  fiscalIssRate     Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointments    Appointment[]
  appointmentItems AppointmentServiceItem[]
  @@index([companyId, name])
}

model Appointment {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       Tutor             @relation(fields: [tutorId], references: [id])
  petId       String
  pet         Pet               @relation(fields: [petId], references: [id])
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  receivable  Receivable?
  items       AppointmentServiceItem[]
  @@index([companyId, startsAt])
  @@index([petId])
}

model AppointmentServiceItem {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  category      String?
  createdAt     DateTime    @default(now())

  @@index([companyId, appointmentId])
  @@index([serviceId])
}

model Receivable {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor            @relation(fields: [tutorId], references: [id])
  appointmentId String?          @unique
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  description   String
  amount        Decimal          @db.Decimal(10, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(10, 2)
  dueDate       DateTime
  status        ReceivableStatus @default(OPEN)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  payments      Payment[]
  @@index([companyId, status, dueDate])
}

model Payment {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivableId String
  receivable   Receivable    @relation(fields: [receivableId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())
  @@index([companyId, paidAt])
}

model Product {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  sku          String?
  ean          String?
  brand        String?
  supplier     String?
  salePrice    Decimal  @db.Decimal(10, 2)
  costPrice    Decimal? @db.Decimal(10, 2)
  stock        Decimal  @default(0) @db.Decimal(10, 3)
  minimumStock Decimal  @default(0) @db.Decimal(10, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movements    StockMovement[]
  @@index([companyId, name])
}

model StockMovement {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Decimal           @db.Decimal(10, 3)
  reason    String?
  createdAt DateTime          @default(now())
  @@index([companyId, createdAt])
}

model LoyaltyAccount {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tutorId     String   @unique
  tutor       Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  points      Int      @default(0)
  cashback    Decimal  @default(0) @db.Decimal(10, 2)
  level       String?
  updatedAt   DateTime @updatedAt
  @@index([companyId])
}

model PlanHistory {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  previousPlan Plan?
  newPlan     Plan
  changedAt   DateTime @default(now())
  lockedUntil DateTime?
  @@index([companyId, changedAt])
}

model ConnectTicket {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  ConnectMessage[]
  @@index([companyId, status])
}

model ConnectMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    ConnectTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  readAt    DateTime?
  createdAt DateTime      @default(now())
  @@index([ticketId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}



model FiscalConfig {
  id                    String                @id @default(cuid())
  companyId             String                @unique
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalName             String?
  tradeName             String?
  cnpj                  String?
  municipalRegistration String?
  taxRegime             String?
  simplesNacional       Boolean               @default(false)
  city                  String?
  state                 String?
  ibgeCode              String?
  serviceListCode       String?
  cnae                  String?
  nbsCode               String?
  issRate               Decimal?              @db.Decimal(5, 2)
  integrationType       FiscalIntegrationType @default(NATIONAL)
  municipalProvider     String?
  environment           FiscalEnvironment     @default(HOMOLOGATION)
  certificateName       String?
  certificateExpiresAt  DateTime?
  active                Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model FiscalDocument {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status           FiscalDocumentStatus @default(DRAFT)
  environment      FiscalEnvironment    @default(HOMOLOGATION)
  integrationType  FiscalIntegrationType
  saleReference    String?
  tutorName        String?
  tutorDocument    String?
  serviceDescription String
  serviceAmount    Decimal              @db.Decimal(12, 2)
  issAmount        Decimal?             @db.Decimal(12, 2)
  rpsNumber        String?
  nfseNumber       String?
  verificationCode String?
  xmlUrl           String?
  pdfUrl           String?
  errorMessage     String?
  requestPayload   Json?
  responsePayload  Json?
  issuedAt         DateTime?
  canceledAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model SaaSSettings {
  id                   String  @id @default("global")
  publicSignupEnabled  Boolean @default(true)
  trialDays             Int     @default(2)
  defaultTrialPlan      Plan    @default(PROFISSIONAL)
  welcomeMessage        String  @default("Bem-vindo ao ForgePets!")
  updatedAt             DateTime @updatedAt
}

model AsaasWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  payload   Json
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}
