# Neon: use a URL com pooler no runtime da Vercel.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/forgepets?sslmode=require"

# Neon: use a URL direta para migrations.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/forgepets?sslmode=require"

# Gere uma chave longa e aleatoria para os tokens de sessao.
JWT_SECRET="troque-por-uma-chave-longa-com-pelo-menos-32-caracteres"

# Credenciais usadas somente pelo seed inicial.
SEED_MASTER_EMAIL="master@forgepets.com"
SEED_MASTER_PASSWORD="123456"
SEED_ADMIN_EMAIL="admin@forgepets.com"
SEED_ADMIN_PASSWORD="123456"
